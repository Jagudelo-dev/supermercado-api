{
  "info": {
    "name": "Supermercado API",
    "description": "Colección de solicitudes manuales para la API REST de gestión de supermercado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "categoriaId", "value": "1" },
    { "key": "proveedorId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "clienteId", "value": "1" },
    { "key": "ventaId", "value": "1" },
    { "key": "documento", "value": "1234567890" }
  ],
  "item": [
    {
      "name": "Categoria",
      "item": [
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bebidas\",\n  \"descripcion\": \"Gaseosas, jugos y aguas\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/categorias"
          },
          "response": []
        },
        {
          "name": "Listar categorías",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categorias" },
          "response": []
        },
        {
          "name": "Buscar categoría por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categorias/{{categoriaId}}" },
          "response": []
        },
        {
          "name": "Actualizar categoría",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bebidas sin alcohol\",\n  \"descripcion\": \"Aguas, jugos y gaseosas\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}"
          },
          "response": []
        },
        {
          "name": "Eliminar categoría",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categorias/{{categoriaId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Proveedor",
      "item": [
        {
          "name": "Crear proveedor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Distribuidora Central\",\n  \"telefono\": \"3001234567\",\n  \"correo\": \"ventas@distribuidora.example\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/proveedores"
          },
          "response": []
        },
        {
          "name": "Listar proveedores",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/proveedores" },
          "response": []
        },
        {
          "name": "Buscar proveedor por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/proveedores/{{proveedorId}}" },
          "response": []
        },
        {
          "name": "Actualizar proveedor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Distribuidora Central\",\n  \"telefono\": \"3007654321\",\n  \"correo\": \"contacto@distribuidora.example\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/proveedores/{{proveedorId}}"
          },
          "response": []
        },
        {
          "name": "Eliminar proveedor",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/proveedores/{{proveedorId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Producto",
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Agua mineral 600 ml\",\n  \"codigoBarras\": \"7701234567890\",\n  \"precio\": 2500.00,\n  \"stock\": 40,\n  \"categoriaId\": {{categoriaId}},\n  \"proveedorId\": {{proveedorId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/productos"
          },
          "response": []
        },
        {
          "name": "Listar productos",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/productos" },
          "response": []
        },
        {
          "name": "Buscar producto por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/{{productoId}}" },
          "response": []
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Agua mineral 600 ml\",\n  \"codigoBarras\": \"7701234567890\",\n  \"precio\": 2700.00,\n  \"stock\": 35,\n  \"categoriaId\": {{categoriaId}},\n  \"proveedorId\": {{proveedorId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/productos/{{productoId}}"
          },
          "response": []
        },
        {
          "name": "Eliminar producto",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/productos/{{productoId}}" },
          "response": []
        },
        {
          "name": "Listar productos por categoría",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/categoria/{{categoriaId}}" },
          "response": []
        },
        {
          "name": "Buscar productos por nombre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos/buscar?nombre=agua",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "buscar"],
              "query": [{ "key": "nombre", "value": "agua" }]
            }
          },
          "response": []
        },
        {
          "name": "Listar productos con stock bajo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos/stock-bajo?limite=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "stock-bajo"],
              "query": [{ "key": "limite", "value": "10" }]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cliente",
      "item": [
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"documento\": \"1234567890\",\n  \"telefono\": \"3101234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/clientes"
          },
          "response": []
        },
        {
          "name": "Listar clientes",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clientes" },
          "response": []
        },
        {
          "name": "Buscar cliente por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clientes/{{clienteId}}" },
          "response": []
        },
        {
          "name": "Actualizar cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana María Pérez\",\n  \"documento\": \"1234567890\",\n  \"telefono\": \"3107654321\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
          },
          "response": []
        },
        {
          "name": "Eliminar cliente",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/clientes/{{clienteId}}" },
          "response": []
        },
        {
          "name": "Buscar cliente por documento",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clientes/documento/{{documento}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Venta",
      "item": [
        {
          "name": "Crear venta con detalles",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"detalles\": [\n    {\n      \"productoId\": {{productoId}},\n      \"cantidad\": 2\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/ventas"
          },
          "response": []
        },
        {
          "name": "Listar ventas",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/ventas" },
          "response": []
        },
        {
          "name": "Buscar venta por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/ventas/{{ventaId}}" },
          "response": []
        },
        {
          "name": "Eliminar venta y restituir stock",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/ventas/{{ventaId}}" },
          "response": []
        },
        {
          "name": "Listar ventas por cliente",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/ventas/cliente/{{clienteId}}" },
          "response": []
        },
        {
          "name": "Buscar ventas por rango de fechas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ventas/fecha?inicio=2026-01-01T00:00:00&fin=2026-12-31T23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ventas", "fecha"],
              "query": [
                { "key": "inicio", "value": "2026-01-01T00:00:00" },
                { "key": "fin", "value": "2026-12-31T23:59:59" }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
